{
  "name": "aeroscope-cloud",
  "private": true,
  "type": "module",
  "description": "AEROSCOPE AWS backend: CDK app (infrastructure) and TypeScript Lambda functions shared by the web dashboard, iPhone companion and Apple Watch.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "synth": "cdk synth --quiet",
    "dev": "tsx scripts/dev-server.ts",
    "deploy:plan": "bash scripts/deploy.sh",
    "deploy:execute": "bash scripts/deploy.sh --execute"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-dynamodb": "^3.1149.0",
    "@aws-sdk/client-eventbridge": "^3.1149.0",
    "@aws-sdk/client-geo-routes": "^3.1149.0",
    "@aws-sdk/client-sns": "^3.1149.0",
    "@aws-sdk/credential-provider-node": "^3.972.85",
    "@aws-sdk/lib-dynamodb": "^3.1149.0",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.4"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "aws-cdk": "^2.1145.0",
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
